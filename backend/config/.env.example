HTTP_PORT=8080
APP_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=ruangx
DB_PASSWORD=ruangx_secret
DB_NAME=ruangx
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=super-secret-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# CORS — use * during development, comma-separated origins for production
ALLOWED_ORIGINS=*

# S3 Config
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ruangx
S3_REGION=ap-southeast-3
S3_USE_SSL=true