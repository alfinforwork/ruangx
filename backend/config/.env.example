HTTP_PORT=8080
APP_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=ruangx
DB_PASSWORD=ruangx_secret
DB_NAME=ruangx
DB_SSLMODE=disable

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=super-secret-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=ruangx-media
S3_REGION=us-east-1
S3_USE_SSL=false

# CORS — use * during development, comma-separated origins for production
ALLOWED_ORIGINS=*